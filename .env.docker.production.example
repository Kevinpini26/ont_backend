# Gabarit pour .env.docker.production — copier ce fichier
# (cp .env.docker.production.example .env.docker.production) et renseigner
# de vraies valeurs. .env.docker.production est gitignored : ne jamais le
# committer, il contiendra de vrais secrets.
#
# Voir SECURITY.md pour la liste complète des réglages obligatoires avant
# mise en ligne.

APP_NAME="Office National du Tourisme"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.exemple.cd
APP_LOCALE=fr

FRONTEND_URL=https://exemple.cd

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=ont
DB_USERNAME=ont
DB_PASSWORD=

SANCTUM_TOKEN_EXPIRATION=480
AUTH_PASSWORD_RESET_EXPIRE=30

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="ne-pas-repondre@exemple.cd"
MAIL_FROM_NAME="${APP_NAME}"

# Une sauvegarde sur le même serveur que l'application ne protège de
# rien : backups-local est refusé au démarrage en production (voir
# Modules\Kernel\Support\BackupDiskProductionGuard). Renseigner un vrai
# stockage S3 (ou compatible) distinct de ce serveur.
BACKUP_DISK=backups-s3
BACKUP_RETENTION_DAYS=30
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=

QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database

# Utilisé par le build du frontend (voir docker-compose.yml, service
# frontend) — même domaine que APP_URL ci-dessus, avec /api/v1.
VITE_API_BASE_URL=https://api.exemple.cd/api/v1
