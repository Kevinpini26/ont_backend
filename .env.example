APP_NAME="ONT - Systeme d'Information"
APP_ENV=local
APP_KEY=
# En production : APP_DEBUG doit impérativement être à false (sinon les
# traces d'exception, requêtes SQL et chemins serveur fuitent dans les
# réponses JSON d'erreur).
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ont
DB_USERNAME=ont
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Par défaut, les emails sont seulement écrits dans les logs (aucun envoi
# réel) : suffisant pour la plupart du développement local. Pour tester un
# envoi réel (ex. via un compte Gmail avec un mot de passe d'application,
# jamais votre mot de passe de compte), renseigner MAIL_MAILER=smtp et les
# champs ci-dessous avec vos propres identifiants — jamais ceux d'un autre,
# jamais commités.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Origine unique autorisée en CORS (SPA React) — voir config/cors.php.
# Aucun wildcard en production : un seul domaine de confiance.
FRONTEND_URL=http://localhost:5173

# Durée de validité du lien signé vers le PDF officiel de réponse (7 jours).
COURRIER_REPONSE_LIEN_TTL_MINUTES=10080

# Durée de vie d'un jeton Sanctum, en minutes (8h par défaut). Un
# administrateur peut révoquer les jetons d'un compte à tout moment via
# DELETE /api/v1/users/{user}/tokens (compte compromis, appareil perdu...).
SANCTUM_TOKEN_EXPIRATION=480

# Sauvegarde automatique quotidienne de la base (voir SauvegarderBaseDeDonneesCommand).
# "backups-local" par défaut = stockage local, UNIQUEMENT pour le développement.
# Positionner BACKUP_DISK=backups-s3 avec de vrais identifiants avant tout
# déploiement réel : une sauvegarde sur le même serveur que l'application ne
# protège de rien en cas de panne ou de compromission de ce serveur.
BACKUP_DISK=backups-local
BACKUP_RETENTION_DAYS=30
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_USE_PATH_STYLE_ENDPOINT=true
