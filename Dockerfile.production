# Image de production — distincte de Dockerfile (développement local, PHP
# CLI via artisan serve). Multi-étapes : les dépendances Composer sont
# installées dans une étape séparée pour ne pas embarquer composer/git dans
# l'image finale, et pour profiter du cache Docker (le composer.lock ne
# change pas à chaque commit applicatif).
#
# php-fpm + opcache, pas `artisan serve` (mono-thread, jamais destiné à la
# production). Le worker de file et le planificateur sont des PROCESSUS
# SÉPARÉS, pas embarqués dans ce conteneur : voir docker-compose.yml
# (services queue-worker / scheduler, même image, CMD différent).

FROM composer:2 AS vendor

WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install \
        --no-dev \
        --no-scripts \
        --no-autoloader \
        --prefer-dist \
        --no-interaction

COPY . .

# Doivent exister (même vides), pour tout artisan/composer script exécuté
# plus tard (y compris à l'exécution) : le config par défaut de Laravel
# résout view.compiled via realpath(storage_path('framework/views')), qui
# renvoie false si le dossier n'existe pas — Blade refuse alors même une
# valeur de cache. .dockerignore exclut le contenu de ces dossiers (jamais
# des fichiers d'exécution figés dans l'image), pas les dossiers eux-mêmes,
# mais ne garantit pas leur présence : on les recrée explicitement.
RUN mkdir -p storage/framework/cache storage/framework/sessions storage/framework/views \
        storage/logs storage/app/private bootstrap/cache

# --no-scripts : composer dump-autoload déclenche par défaut
# `package:discover`, qui démarre Laravel en entier — donc avec les
# variables d'environnement de CE build (aucune, .env n'est jamais copié
# dans l'image), jamais celles de l'environnement cible réel. Un garde de
# démarrage sensible à l'environnement (ex. BackupDiskProductionGuard,
# APP_ENV valant "production" par défaut en l'absence de .env) ferait alors
# échouer la construction de l'image quel que soit le déploiement visé.
# Même principe que config:cache/route:cache/view:cache ci-dessous : tout
# ce qui dépend de l'environnement réel est reporté à entrypoint.sh, jamais
# fait à la construction (voir son commentaire).
RUN composer dump-autoload --optimize --no-dev --no-scripts

FROM php:8.3-fpm-alpine AS final

RUN apk add --no-cache \
        postgresql-client \
        libpq \
        icu-libs \
        libzip \
    && apk add --no-cache --virtual .build-deps \
        postgresql-dev \
        icu-dev \
        libzip-dev \
        $PHPIZE_DEPS \
    && docker-php-ext-install pdo_pgsql pgsql zip intl bcmath opcache \
    && apk del .build-deps

# Réglages opcache de production — validate_timestamps=0 : le cache n'est
# jamais invalidé automatiquement, un déploiement doit redémarrer php-fpm
# (c'est le comportement attendu d'une image immuable, pas un oubli).
RUN { \
        echo 'opcache.enable=1'; \
        echo 'opcache.memory_consumption=128'; \
        echo 'opcache.max_accelerated_files=10000'; \
        echo 'opcache.validate_timestamps=0'; \
        echo 'opcache.jit=tracing'; \
        echo 'opcache.jit_buffer_size=64M'; \
    } > /usr/local/etc/php/conf.d/opcache-production.ini

WORKDIR /var/www/html

COPY --from=vendor /app /var/www/html

COPY docker/entrypoint.production.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh \
    && chown -R www-data:www-data /var/www/html/storage /var/www/html/bootstrap/cache

USER www-data

ENTRYPOINT ["entrypoint.sh"]
CMD ["php-fpm"]
